#include <iostream>
using namespace std;

struct Node {
    int data;
    Node* prev;
    Node* next;
};

class DoublyLinkedList {
private:
    Node* head;
    Node* tail;

public:
    DoublyLinkedList() : head(nullptr), tail(nullptr) {}

    // Insert at the left (front)
    void insertLeft(int val) {
        Node* newNode = new Node{val, nullptr, head};
        if (head != nullptr) {
            head->prev = newNode;
        } else {
            tail = newNode;
        }
        head = newNode;
    }

    // Insert at the right (back)
    void insertRight(int val) {
        Node* newNode = new Node{val, tail, nullptr};
        if (tail != nullptr) {
            tail->next = newNode;
        } else {
            head = newNode;
        }
        tail = newNode;
    }

    // Remove from the left (front)
    void removeLeft() {
        if (head == nullptr) {
            cout << "List is empty!\n";
            return;
        }
        Node* temp = head;
        head = head->next;
        if (head != nullptr) {
            head->prev = nullptr;
        } else {
            tail = nullptr;
        }
        cout << "Removed from left: " << temp->data << "\n";
        delete temp;
    }

    // Remove from the right (back)
    void removeRight() {
        if (tail == nullptr) {
            cout << "List is empty!\n";
            return;
        }
        Node* temp = tail;
        tail = tail->prev;
        if (tail != nullptr) {
            tail->next = nullptr;
        } else {
            head = nullptr;
        }
        cout << "Removed from right: " << temp->data << "\n";
        delete temp;
    }

    // Show list from left to right
    void showLeftToRight() {
        if (head == nullptr) {
            cout << "List is empty.\n";
            return;
        }
        cout << "Left -> Right: ";
        Node* temp = head;
        while (temp != nullptr) {
            cout << temp->data << " <-> ";
            temp = temp->next;
        }
        cout << "NULL\n";
    }

    // Show list from right to left
    void showRightToLeft() {
        if (tail == nullptr) {
            cout << "List is empty.\n";
            return;
        }
        cout << "Right -> Left: ";
        Node* temp = tail;
        while (temp != nullptr) {
            cout << temp->data << " <-> ";
            temp = temp->prev;
        }
        cout << "NULL\n";
    }

    // Destructor to clean up memory
    ~DoublyLinkedList() {
        while (head != nullptr) {
            Node* temp = head;
            head = head->next;
            delete temp;
        }
    }
};

int main() {
    DoublyLinkedList list;
    int choice, value;

    while (true) {
        cout << "\n--- MENU ---\n"
             << "1. Insert Left (Front)\n"
             << "2. Insert Right (Back)\n"
             << "3. Remove Left (Front)\n"
             << "4. Remove Right (Back)\n"
             << "5. Show Left to Right\n"
             << "6. Show Right to Left\n"
             << "0. Exit\n"
             << "Enter choice: ";
        cin >> choice;

        switch (choice) {
            case 1:
                cout << "Enter value: ";
                cin >> value;
                list.insertLeft(value);
                break;
            case 2:
                cout << "Enter value: ";
                cin >> value;
                list.insertRight(value);
                break;
            case 3:
                list.removeLeft();
                break;
            case 4:
                list.removeRight();
                break;
            case 5:
                list.showLeftToRight();
                break;
            case 6:
                list.showRightToLeft();
                break;
            case 0:
                return 0;
            default:
                cout << "Invalid choice. Try again.\n";
        }
    }
}
